            "value": "<script>\n(function(){\n  if (!window.fbq) return;\n  var ev = {{Event}};\n  var dados = { pagina: {{DL - pagina}} };\n  if (ev.indexOf('clique_') === 0) {\n    dados.canal = ev.replace('clique_', '');\n    fbq('track', 'Contact', dados);\n  } else if (ev === 'pedido_enviado') {\n    dados.servico = {{DL - servico}};\n    dados.canal = {{DL - canal}};\n    fbq('track', 'Lead', dados);\n  } else if (ev === 'simulacao') {\n    dados.produto = {{DL - produto}};\n    fbq('trackCustom', 'simulacao', dados);\n  }\n})();\n</script>"
