---
// Aviso de cookies (LGPD) + Google Tag Manager (que carrega o Analytics e o Pixel da Meta).
// Nada é carregado antes de a pessoa clicar em "Aceitar"; a escolha fica no
// navegador dela e pode ser revista pelo link "Preferências de cookies" do rodapé.
// O site só avisa os eventos ao Tag Manager (dataLayer); o que cada ferramenta
// recebe é configurado lá (gtm/container-dicoon-invest.json).
import { rastreamento } from '../../config'

const gtm = rastreamento.tagManager
const ativo = Boolean(gtm)
---

{
  ativo && (
    <div
      id="aviso-cookies"
      hidden
      role="dialog"
      aria-label="Aviso de cookies"
      class="fixed inset-x-0 bottom-0 z-[60] border-t border-white/10 bg-navy-deep text-white shadow-2xl"
    >
      <div class="container-site flex flex-col gap-4 py-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-relaxed text-white/80">
          Usamos cookies para medir as visitas e melhorar nossos anúncios (Google Analytics e Meta). Você escolhe se aceita. Saiba mais na{' '}
          <a href="/politica-de-privacidade" class="font-semibold text-gold hover:underline">
            Política de privacidade
          </a>
          .
        </p>
        <div class="flex shrink-0 gap-3">
          <button type="button" data-cookies="recusado" class="rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white hover:border-gold hover:text-gold">
            Recusar
          </button>
          <button type="button" data-cookies="aceito" class="rounded-full bg-gold px-5 py-2.5 text-sm font-bold text-navy hover:bg-gold-dark">
            Aceitar
          </button>
        </div>
      </div>
    </div>
  )
}

<script is:inline define:vars={{ gtm, ativo }}>
  ;(() => {
    const CHAVE = 'dicoon-consentimento'
    let ligado = false
    const ler = () => {
      try {
        return localStorage.getItem(CHAVE)
      } catch {
        return null
      }
    }
    const gravar = (v) => {
      try {
        localStorage.setItem(CHAVE, v)
      } catch {}
    }

    function ligar() {
      if (ligado || !ativo) return
      ligado = true
      window.dataLayer = window.dataLayer || []
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
      const s = document.createElement('script')
      s.async = true
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm
      document.head.appendChild(s)
    }

    // Eventos do site para o Tag Manager. Nunca enviar dados pessoais
    // (nome, telefone, e-mail, valores digitados).
    window.dicoonEvento = (nome, dados = {}) => {
      if (!ligado) return
      window.dataLayer.push({ event: nome, pagina: location.pathname, ...dados })
    }

    // Cliques que saem do site, por canal.
    const canais = [
      ['clique_whatsapp', /(wa\.me|whatsapp\.com)/i],
      ['clique_messenger', /(m\.me|messenger\.com)/i],
      ['clique_instagram', /instagram\.com/i],
      ['clique_facebook', /(facebook\.com|fb\.com)/i],
      ['clique_tiktok', /tiktok\.com/i],
      ['clique_email', /^mailto:/i],
      ['clique_telefone', /^tel:/i],
    ]
    document.addEventListener(
      'click',
      (e) => {
        const link = e.target instanceof Element && e.target.closest('a[href]')
        if (!link) return
        const href = link.getAttribute('href') || ''
        const canal = canais.find(([, padrao]) => padrao.test(href))
        if (canal) window.dicoonEvento(canal[0])
      },
      true,
    )

    const aviso = document.getElementById('aviso-cookies')
    if (!aviso) return
    aviso.addEventListener('click', (e) => {
      const escolha = e.target instanceof Element && e.target.closest('[data-cookies]')?.getAttribute('data-cookies')
      if (!escolha) return
      gravar(escolha)
      aviso.hidden = true
      if (escolha === 'aceito') ligar()
      // Recusou depois de ter aceitado: recarrega para descarregar o Analytics e o Pixel.
      else if (ligado) location.reload()
    })
    document.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('[data-preferencias-cookies]')) aviso.hidden = false
    })

    const escolha = ler()
    if (escolha === 'aceito') ligar()
    else if (!escolha) aviso.hidden = false
  })()
</script>
