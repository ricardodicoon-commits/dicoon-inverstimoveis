---
import PaginaTexto from '../layouts/PaginaTexto.astro'
import Icone from '../components/site/Icone.astro'
import { linkWhatsApp } from '../config'
import { parceiros, consorcios } from '../data/parceiros'

// Logos aprovadas pelo Ricardo em 2026-10-21 (mesma lista da home). A descrição para o Google
// fica genérica de propósito: não citar instituições por nome.
const grupos = [
  { titulo: 'Bancos e instituições financeiras', itens: parceiros.filter((p) => p.tipo === 'banco'), colunas: 'grid-cols-2 sm:grid-cols-4' },
  { titulo: 'Seguradoras', itens: parceiros.filter((p) => p.tipo === 'seguradora'), colunas: 'grid-cols-2 sm:grid-cols-4 lg:grid-cols-8' },
]

const passos = [
  { titulo: 'Você conta o que precisa', texto: 'Entendemos o seu objetivo e o seu perfil.' },
  { titulo: 'Comparamos as instituições', texto: 'Levamos a proposta às parceiras que atendem aquele tipo de operação.' },
  { titulo: 'Você escolhe', texto: 'Apresentamos as alternativas e você decide com informação.' },
  { titulo: 'A instituição analisa e contrata', texto: 'A análise, a aprovação e o contrato são feitos pela instituição escolhida.' },
]
---

<PaginaTexto
  url="/parceiros"
  seoTitulo="Instituições parceiras e parcerias | Dicoon Invest"
  seoDescricao="Saiba como a Dicoon Invest trabalha com diversas instituições financeiras e seguradoras parceiras e como corretores e empresas podem ser parceiros."
  h1="Instituições parceiras"
  intro="Trabalhamos com bancos, seguradoras e instituições financeiras parceiras para buscar alternativas de crédito, financiamento, consórcio e seguros conforme o perfil de cada cliente."
>
  <section class="bg-white py-16 sm:py-20">
    <div class="container-site">
      {
        grupos.map((g, n) => (
          <div class={n ? 'mt-14' : ''}>
            <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">{g.titulo}</h2>
            <ul class={`mt-6 grid gap-3 sm:gap-4 ${g.colunas}`}>
              {g.itens.map((p) => (
                <li>
                  <figure class="flex h-full flex-col items-center justify-between gap-3 rounded-[1.5rem] cartao-ouro bg-white p-4 text-center">
                    <div class="flex h-16 w-full items-center justify-center">
                      <img
                        src={`/img/parceiros/${p.arquivo}.webp`}
                        alt={p.alt}
                        width={p.largura}
                        height={p.altura}
                        loading="lazy"
                        decoding="async"
                        class="max-h-16 w-auto max-w-full object-contain"
                      />
                    </div>
                    <figcaption class="text-xs font-semibold text-muted">{p.nome}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="mt-14">
        <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Administradoras de consórcio</h2>
        <ul class="mt-6 grid max-w-4xl grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
          {
            consorcios.map((c) => (
              <li>
                <figure class="flex h-full flex-col items-center justify-between gap-2 rounded-[1.5rem] cartao-ouro bg-white p-3 text-center">
                  <div class="flex h-11 w-full items-center justify-center">
                    {c.arquivo ? (
                      <img
                        src={`/img/parceiros/${c.arquivo}.webp`}
                        alt={c.alt}
                        width={c.largura}
                        height={c.altura}
                        loading="lazy"
                        decoding="async"
                        class="max-h-11 w-auto max-w-[75%] object-contain"
                      />
                    ) : (
                      <span class="font-heading text-base font-extrabold leading-tight text-navy">{c.nome}</span>
                    )}
                  </div>
                  {c.arquivo && <figcaption class="text-xs font-semibold text-muted">{c.nome}</figcaption>}
                  <a
                    href={linkWhatsApp(`Olá! Quero simular um consórcio com a administradora ${c.nome}.`)}
                    target="_blank"
                    rel="noopener"
                    class="mt-1 rounded-full bg-navy px-4 py-2 text-xs font-bold text-white hover:bg-blue"
                  >
                    Simular consórcio
                  </a>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="mt-10 max-w-3xl text-sm text-muted">
        As instituições apresentadas são parceiras conforme disponibilidade e autorização comercial. A aprovação, as taxas, as coberturas e as condições dependem da análise de cada instituição.
      </p>
      <a
        href={linkWhatsApp('Olá! Quero comparar opções de crédito, financiamento, consórcio ou seguro.')}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-block rounded-full bg-gold px-7 py-3.5 font-bold text-navy hover:bg-gold-dark"
      >
        Quero comparar opções
      </a>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-site">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Como funciona a comparação entre instituições</h2>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          passos.map((p, n) => (
            <li class="rounded-card border border-border bg-white p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-navy font-heading font-bold text-gold">{n + 1}</span>
              <h3 class="mt-4 font-bold text-navy">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <div class="texto mt-10 max-w-3xl">
        <p>
          <strong>Transparência:</strong> em toda proposta você sabe qual é a instituição responsável pela operação e quais são as condições oferecidas por ela.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy py-16 text-white sm:py-20">
    <div class="container-site grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gold">Seja parceiro</p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl">É corretor de imóveis ou tem uma empresa?</h2>
        <p class="mt-4 text-white/80">
          Oferecemos assessoria para o financiamento imobiliário dos seus clientes, com acompanhamento da proposta do início ao fim. Vamos conversar sobre como trabalhar juntos.
        </p>
      </div>
      <a
        href={linkWhatsApp('Olá, quero conversar sobre ser parceiro da Dicoon Invest.')}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-gold px-7 py-4 font-bold text-navy hover:bg-gold-dark"
      >
        <Icone nome="maleta" class="h-5 w-5" /> Quero ser parceiro
      </a>
    </div>
  </section>
</PaginaTexto>
