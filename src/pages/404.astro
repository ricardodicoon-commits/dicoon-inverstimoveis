---
import Base from '../layouts/Base.astro'
---

<Base titulo="Página não encontrada | Dicoon Invest" descricao="A página que você procurou não existe ou mudou de endereço." semIndice>
  <section class="container-site py-24 text-center">
    <p class="font-heading text-6xl font-extrabold text-navy">404</p>
    <h1 class="mt-4 text-2xl font-bold text-navy">Página não encontrada</h1>
    <p class="mt-3 text-muted">O endereço pode ter mudado. Volte para o início ou fale com a gente.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-navy px-6 py-3 font-semibold text-white hover:bg-blue">Ir para o início</a>
  </section>
</Base>
