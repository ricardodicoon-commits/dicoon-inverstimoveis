---
// Páginas-guia (Crédito, Para você, Para empresas): apresentam e levam aos serviços.
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import Base from './Base.astro'
import Breadcrumb from '../components/site/Breadcrumb.astro'
import CartoesServico from '../components/site/CartoesServico.astro'
import Icone from '../components/site/Icone.astro'
import SecaoContato from '../components/site/SecaoContato.astro'
import type { Servico } from '../data/servicos'

interface Props {
  url: string
  seoTitulo: string
  seoDescricao: string
  h1: string
  intro: string
  tituloLista: string
  itens: Servico[]
  destaques: { icone: string; titulo: string; texto: string }[]
  imagem?: ImageMetadata
  altImagem?: string
}
const p = Astro.props
---

<Base titulo={p.seoTitulo} descricao={p.seoDescricao}>
  <section class="relative overflow-hidden bg-navy text-white">
    {
      p.imagem && (
        <Picture src={p.imagem} formats={['avif', 'webp']} alt="" widths={[640, 1200]} sizes="100vw" loading="eager" class="absolute inset-0 h-full w-full object-cover opacity-35" />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/90 to-navy/50"></div>
    <div class="container-site relative py-14 sm:py-20">
      <Breadcrumb itens={[{ nome: p.h1, url: p.url }]} />
      <h1 class="mt-8 max-w-3xl text-4xl font-extrabold leading-tight sm:text-5xl">{p.h1}</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/80">{p.intro}</p>
      <a href="#contato" class="mt-8 inline-block rounded-full bg-gold px-7 py-3.5 font-bold text-navy hover:bg-gold-dark">Fale com um especialista</a>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-site">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">{p.tituloLista}</h2>
      <div class="mt-8"><CartoesServico itens={p.itens} colunas={p.itens.length === 4 ? 2 : 3} /></div>
    </div>
  </section>

  <section class="border-y border-border bg-white py-16 sm:py-20">
    <div class="container-site grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        p.destaques.map((d) => (
          <div class="rounded-card border border-border bg-bg p-6">
            <Icone nome={d.icone} class="h-8 w-8 text-blue" />
            <h3 class="mt-4 font-bold text-navy">{d.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{d.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <SecaoContato />
</Base>
