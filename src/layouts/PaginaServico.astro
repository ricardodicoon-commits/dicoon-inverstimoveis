---
import Base from './Base.astro'
import Breadcrumb from '../components/site/Breadcrumb.astro'
import CartoesServico from '../components/site/CartoesServico.astro'
import Icone from '../components/site/Icone.astro'
import SecaoContato from '../components/site/SecaoContato.astro'
import SimuladorFinanciamento from '../components/site/SimuladorFinanciamento'
import SimuladorHomeEquity from '../components/site/SimuladorHomeEquity'
import { servicos, type Servico } from '../data/servicos'
import { linkWhatsApp } from '../config'

interface Props {
  servico: Servico
}
const { servico: s } = Astro.props
const ehCredito = s.url.startsWith('/credito/')
const trilha = ehCredito ? [{ nome: 'Crédito', url: '/credito' }, { nome: s.h1, url: s.url }] : [{ nome: s.h1, url: s.url }]
const tipoFinanciamento = s.slug === 'financiamento-imobiliario' ? 'imovel' : s.slug === 'veicular' ? 'veiculo' : null
const temSimulador = s.slug === 'home-equity' || tipoFinanciamento !== null
// "Home Equity" é nome próprio; os demais entram em minúsculas no meio da frase.
const nomeNaFrase = s.slug === 'home-equity' ? s.nome : s.nome.toLowerCase()
const relacionados =servicos.filter((x) => x.slug !== s.slug && x.publico.some((p) => s.publico.includes(p))).slice(0, 3)
---

<Base titulo={s.seoTitulo} descricao={s.seoDescricao}>
  <section class="bg-navy text-white">
    <div class="container-site py-14 sm:py-20">
      <Breadcrumb itens={trilha} />
      <div class="mt-8 flex items-start gap-5">
        <span class="hidden h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-gold/50 text-gold sm:flex">
          <Icone nome={s.icone} class="h-8 w-8" />
        </span>
        <div>
          <h1 class="text-4xl font-extrabold leading-tight sm:text-5xl">{s.h1}</h1>
          <p class="mt-5 max-w-2xl text-lg text-white/80">{s.intro}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={temSimulador ? '#simulador' : '#contato'} class="rounded-full bg-gold px-7 py-3.5 font-bold text-navy hover:bg-gold-dark">
              Quero uma simulação
            </a>
            <a
              href={linkWhatsApp(`Olá, quero saber mais sobre ${s.nome} na Dicoon Invest.`)}
              target="_blank"
              rel="noopener"
              class="rounded-full border border-white/40 px-7 py-3.5 font-semibold text-white hover:border-gold hover:text-gold"
            >
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    temSimulador && (
      <section id="simulador" class="border-b border-border bg-white py-16 sm:py-20">
        <div class="container-site">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue">Simulador</p>
          <h2 class="mt-2 text-2xl font-extrabold text-navy sm:text-3xl">Simule o seu {nomeNaFrase}</h2>
          <p class="mt-3 max-w-2xl text-muted">
            {tipoFinanciamento
              ? 'Informe o valor, a entrada e o prazo. Você compara na hora as parcelas pelos sistemas SAC e Price, com a taxa média de mercado do Banco Central.'
              : 'Informe o valor do imóvel, quanto você precisa e o prazo. Você vê na hora uma estimativa da parcela.'}
          </p>
          <div class="mt-8">
            {tipoFinanciamento ? (
              <SimuladorFinanciamento client:visible tipoInicial={tipoFinanciamento} escolherTipo={false} />
            ) : (
              <SimuladorHomeEquity client:visible />
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-16 sm:py-20">
    <div class="container-site grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">{s.slug === 'seguros' ? 'Tipos de seguro' : 'Para quem é'}</h2>
        <ul class="mt-6 space-y-3">
          {
            s.paraQuem.map((item) => (
              <li class="flex gap-3 rounded-card border border-border bg-white p-4">
                <Icone nome="check" class="mt-0.5 h-5 w-5 shrink-0 text-blue" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Antes de contratar</h2>
        <div class="mt-6 space-y-4 leading-relaxed text-muted">
          {s.saiba.map((t) => <p>{t}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-white py-16 sm:py-20">
    <div class="container-site">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Como funciona</h2>
      <ol class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          s.passos.map((p, n) => (
            <li class="rounded-card border border-border bg-bg p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-navy font-heading font-bold text-gold">{n + 1}</span>
              <h3 class="mt-4 font-bold text-navy">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-site max-w-3xl">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Dúvidas sobre {nomeNaFrase}</h2>
      <div class="mt-8 space-y-3">
        {
          s.perguntas.map((d) => (
            <details class="group rounded-card border border-border bg-white p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading font-bold text-navy [&::-webkit-details-marker]:hidden">
                {d.p}
                <span class="text-2xl leading-none text-blue transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-muted">{d.r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="container-site">
      <h2 class="text-2xl font-extrabold text-navy sm:text-3xl">Veja também</h2>
      <div class="mt-8"><CartoesServico itens={relacionados} /></div>
    </div>
  </section>

  <SecaoContato servicoInicial={s.nome} titulo={`Vamos conversar sobre ${nomeNaFrase}?`} />
</Base>
